# Template for the root secrets.yaml all projects share (see README.md).
# Rename this file to secrets.yaml and fill in real values, then symlink
# it into each project folder as described in README.md.
#
# Values below are examples only - none of these are the actual values in use.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
